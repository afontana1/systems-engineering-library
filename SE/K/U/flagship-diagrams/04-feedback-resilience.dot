digraph Dynamics {
 rankdir=LR; bgcolor="transparent"; graph[fontname="DejaVu Sans",pad=.25];node[shape=box,style="rounded,filled",fillcolor="#e6f3f3",color="#477c86",fontname="DejaVu Sans",fontsize=10];edge[color="#607b89",fontname="DejaVu Sans",fontsize=9];
 demand[label="True rider demand"]; backlog[label="Accepted backlog",fillcolor="#f7eedf"]; service[label="Completed services"];wait[label="Longer wait"];retry[label="Repeat requests"];control[label="Extra capacity / load-shedding"];
 demand->backlog;backlog->wait;wait->retry; retry->backlog[label="reinforcing (+)"]; backlog->control; control->service;service->backlog[label="reduces (-)"];
}
