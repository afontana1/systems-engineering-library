digraph Architecture {
rankdir=LR; graph [fontname="Arial", bgcolor="transparent", pad="0.24", nodesep="0.5", ranksep="0.65"];
node [shape=box, style="rounded,filled", fontname="Arial", fontsize=12, color="#b8d4d6", fillcolor="#f0f8f8", fontcolor="#193e4b", margin="0.16,0.12"];
