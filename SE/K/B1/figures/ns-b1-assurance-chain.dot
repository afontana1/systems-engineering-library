digraph Assurance {
  graph [rankdir=LR, bgcolor="transparent",pad="0.2",nodesep=0.42,ranksep=0.62];
  node [shape=box, fontname="DejaVu Sans", fontsize=10, style="rounded,filled", fillcolor="#e4f3f1", color="#236f72",fontcolor="#193e4a",margin="0.12,0.1"];
  edge [color="#607985",penwidth=1.3,arrowsize=0.7];
  need [label="Need NS-N-02"];
  req [label="Requirement NS-R-02"];
  arch [label="Interface allocation\n1.65s budget"];
  test [label="Test conditions +\nNS-B1 configuration"];
  claim [label="Bounded acceptance\nclaim",fillcolor="#fff2ce",color="#ad925c"];
  need->req->arch->test->claim;
}
