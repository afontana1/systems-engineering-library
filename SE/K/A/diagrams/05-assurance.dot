digraph Assurance {rankdir=TB;graph[bgcolor="transparent",pad=.3];node[shape=box,style="rounded,filled",fillcolor="#eef7f7",color="#388b88",fontname="Arial"];claim[label="Bounded mission claim"];sub[label="Performance / safety / resilience subclaims"];arg[label="Argument and assumptions"];ev[label="Configured tests and evidence"];counter[label="Defeaters / counterevidence",fillcolor="#fff1e7",color="#ba7146"];claim->sub;sub->arg;arg->ev;counter->arg[label="challenges",style=dashed,color="#ba7146"];}
