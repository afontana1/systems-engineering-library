digraph Evidence { rankdir=LR; graph [bgcolor="transparent",pad=.25]; node [shape=box,style="rounded,filled",fillcolor="#eaf5f3",color="#287f80",fontname="Arial",fontsize=11]; edge [fontname="Arial",fontsize=9,color="#46757e"]; M[label="Mission outcome"]; N[label="Stakeholder need"]; R[label="Requirement"]; D[label="Design responsibility"]; T[label="Verification procedure"]; E[label="Configured evidence"];M->N[label="motivates"];N->R[label="specified by"];R->D[label="allocated to"];R->T[label="verified by"];T->E[label="produces"]; }
