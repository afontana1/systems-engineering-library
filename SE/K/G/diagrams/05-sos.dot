digraph G {rankdir=LR;graph[bgcolor="transparent"];node[shape=box,style="rounded,filled",fillcolor="#edf7f5",color="#568d90",fontname="DejaVu Sans"];edge[color="#216a78"];Agency[label="Road authority"];Transit[label="Transport agency"];Hospital[label="Hospital"];Emergency[label="Emergency dispatcher"];Agency->Transit[label="binding closure?"];Transit->Hospital[label="transfer request"];Emergency->Transit[label="mission priority"];Hospital->Emergency[label="capacity notice"];Agency->Emergency[label="incident status",constraint=false];}