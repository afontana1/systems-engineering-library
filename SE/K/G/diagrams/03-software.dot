digraph G {rankdir=LR;graph[bgcolor="transparent"];node[shape=box,style="rounded,filled",fillcolor="#edf7f5",color="#568d90",fontname="DejaVu Sans"];edge[color="#216a78"];App[label="Client\nrequest + key"];Service[label="Reservation\nservice"];DB[label="Transactional store\nunique key + outcome"];Outbox[label="Outbox\nevent intent"];Consumer[label="Downstream\ndeduplicate"];App->Service[label="request / retry"];Service->DB[label="atomic commit"];DB->Outbox;Outbox->Consumer;Service->App[label="same result",constraint=false];}