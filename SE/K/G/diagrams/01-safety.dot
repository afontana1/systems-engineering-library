digraph G {rankdir=LR;graph [bgcolor="transparent",pad=.18]; node [shape=box,style="rounded,filled",fillcolor="#edf7f5",color="#568d90",fontname="DejaVu Sans"];edge[color="#216a78",fontname="DejaVu Sans"]; Authority [label="Road authority\nstatus + timestamp"]; Route [label="Route evidence\nrevision + expiry"]; Scheduler [label="Dispatch decision"]; Vehicle [label="Vehicle executes"]; Monitor [label="Telemetry / incident"];Authority->Route->Scheduler->Vehicle;Vehicle->Monitor;Monitor->Scheduler [label="feedback",constraint=false];}